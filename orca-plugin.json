{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "antigravity-rotator",
  "publisher": "syharipf",
  "name": "Antigravity 账号切换",
  "version": "1.0.0",
  "description": "查看本机 Antigravity 账号的 Gemini 剩余额度和综合评分，推荐候补账号，并可开启低额度自动轮换。",
  "license": "MIT",
  "author": { "name": "syharipf" },
  "repository": "https://github.com/Syharipf/orca-agy-rotator",
  "icon": "images/icon.png",
  "engines": { "orca": ">=1.4.248" },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.mjs",
  "contributes": {
    "panels": [
      {
        "id": "antigravity-switcher",
        "title": "Antigravity 账号",
        "icon": "refresh",
        "entry": "panel/index.html"
      }
    ],
    "commands": [
      { "id": "toggle-panel", "title": "打开 Antigravity 账号面板", "action": "sidebar.right.toggle" },
      { "id": "rotate-now", "title": "Antigravity：切换推荐账号" }
    ],
    "statusBarItems": [
      {
        "id": "agy-status",
        "text": "Antigravity：读取中",
        "icon": "refresh",
        "tooltip": "查看本机 Antigravity 账号及剩余额度",
        "command": "toggle-panel"
      }
    ],
    "events": [{ "on": "workspace.changed" }]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "notifications:show" },
    { "kind": "storage:own" }
  ]
}
